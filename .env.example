# Copy to .env and adjust. Every value here is a development default.
POSTGRES_DB=novafer
POSTGRES_USER=novafer
POSTGRES_PASSWORD=novafer
POSTGRES_PORT=5434

BACKEND_PORT=8085
FRONTEND_PORT=8086

# Generate a real secret for any shared deployment (at least 32 bytes).
JWT_SECRET=dev-only-docker-compose-secret-0123456789abcdefghij
CORS_ALLOWED_ORIGINS=http://localhost:8086,http://localhost:4200

# Demo company and fifteen months of fictional history (dev profile only).
DEMO_DATA=true

# Optional first administrator, created at startup if it does not exist.
ADMIN_EMAIL=
ADMIN_PASSWORD=
